{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duplocloud.example/schema/aiops-onboarding.v1.schema.json",
  "title": "DuploCloud AI Ops Onboarding Spec v1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "context", "providers", "inputs", "components", "workflows"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "aiops.duplocloud.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "OnboardingSpec"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "client", "environment", "owner"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "client": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "createdBy": { "type": "string" },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["objective", "guardrails"],
      "additionalProperties": false,
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "guardrails": {
          "type": "object",
          "required": ["allowApply", "allowImport", "allowStateOps", "requireValidate", "planPolicy", "secretsPolicy"],
          "additionalProperties": false,
          "properties": {
            "allowApply": { "type": "boolean" },
            "allowImport": { "type": "boolean" },
            "allowStateOps": { "type": "boolean" },
            "requireValidate": { "type": "boolean" },
            "planPolicy": {
              "type": "object",
              "required": ["failOnDeleteOrReplace"],
              "additionalProperties": false,
              "properties": {
                "failOnDeleteOrReplace": { "type": "boolean" }
              }
            },
            "secretsPolicy": {
              "type": "object",
              "required": ["allowPlaintextInSpec"],
              "additionalProperties": false,
              "properties": {
                "allowPlaintextInSpec": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "required": ["duplocloud", "terraform"],
      "additionalProperties": false,
      "properties": {
        "duplocloud": {
          "type": "object",
          "required": ["hostEnv", "tokenEnv", "tenant"],
          "additionalProperties": false,
          "properties": {
            "hostEnv": { "type": "string", "minLength": 1 },
            "tokenEnv": { "type": "string", "minLength": 1 },
            "tenant": {
              "type": "object",
              "required": ["mode"],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["existing", "create", "lookup"]
                },
                "tenantId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "tenantName": { "type": "string" },
                "planId": { "type": ["string", "null"] }
              },
              "allOf": [
                {
                  "if": { "properties": { "mode": { "const": "existing" } } },
                  "then": { "required": ["tenantId"] }
                },
                {
                  "if": { "properties": { "mode": { "const": "create" } } },
                  "then": { "required": ["tenantName"] }
                }
              ]
            }
          }
        },
        "terraform": {
          "type": "object",
          "required": ["requiredProviders", "backend"],
          "additionalProperties": false,
          "properties": {
            "requiredProviders": {
              "type": "object",
              "required": ["duplocloud"],
              "additionalProperties": false,
              "properties": {
                "duplocloud": {
                  "type": "object",
                  "required": ["source", "version"],
                  "additionalProperties": false,
                  "properties": {
                    "source": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "backend": {
              "type": "object",
              "required": ["enabled", "configFile"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "configFile": { "type": ["string", "null"] }
              },
              "allOf": [
                {
                  "if": { "properties": { "enabled": { "const": true } } },
                  "then": { "required": ["configFile"] }
                }
              ]
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["naming", "tags"],
      "additionalProperties": false,
      "properties": {
        "naming": {
          "type": "object",
          "required": ["prefix", "delimiter"],
          "additionalProperties": false,
          "properties": {
            "prefix": { "type": "string", "minLength": 1 },
            "delimiter": { "type": "string", "minLength": 1 }
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tfRoot": { "type": "string" },
            "modulesDir": { "type": "string" },
            "envsDir": { "type": "string" },
            "runtimeDir": { "type": "string" }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "required": ["duplo", "terraform"],
      "additionalProperties": false,
      "properties": {
        "duplo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "infrastructure": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "infraName": { "type": ["string", "null"] },
                "region": { "type": ["string", "null"] },
                "enableK8Cluster": { "type": ["boolean", "null"] },
                "addressPrefix": { "type": ["string", "null"] }
              },
              "allOf": [
                {
                  "if": { "properties": { "enabled": { "const": true } } },
                  "then": { "required": ["infraName", "region", "enableK8Cluster", "addressPrefix"] }
                }
              ]
            },
            "s3Buckets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "versioning": { "type": "boolean", "default": true },
                  "publicAccess": { "type": "boolean", "default": false },
                  "encryption": {
                    "type": "object",
                    "required": ["mode"],
                    "additionalProperties": false,
                    "properties": {
                      "mode": { "type": "string", "enum": ["sse-s3", "sse-kms"] },
                      "kmsKeyArn": { "type": ["string", "null"] }
                    },
                    "allOf": [
                      {
                        "if": { "properties": { "mode": { "const": "sse-kms" } } },
                        "then": { "required": ["kmsKeyArn"] }
                      }
                    ]
                  }
                }
              }
            },
            "tenantNetworkSecurityRules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["description", "protocol", "fromPort", "toPort", "source"],
                "additionalProperties": false,
                "properties": {
                  "description": { "type": "string", "minLength": 1 },
                  "protocol": { "type": "string", "enum": ["tcp", "udp", "-1"] },
                  "fromPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
                  "toPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
                  "source": {
                    "type": "object",
                    "required": ["type", "value"],
                    "additionalProperties": false,
                    "properties": {
                      "type": { "type": "string", "enum": ["cidr", "tenant"] },
                      "value": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            "services": { "type": "array", "default": [] },
            "rds": { "type": "array", "default": [] },
            "eks": { "type": "array", "default": [] }
          },
          "required": ["infrastructure", "s3Buckets", "tenantNetworkSecurityRules"]
        },
        "terraform": {
          "type": "object",
          "required": ["layout", "generation"],
          "additionalProperties": false,
          "properties": {
            "layout": {
              "type": "object",
              "required": ["mode", "moduleNamespace"],
              "additionalProperties": false,
              "properties": {
                "mode": { "type": "string", "enum": ["explicit", "infer"] },
                "moduleNamespace": { "type": "string", "minLength": 1 }
              }
            },
            "generation": {
              "type": "object",
              "required": ["style", "createReadme", "emitRuntimeArtifacts"],
              "additionalProperties": false,
              "properties": {
                "style": { "type": "string", "enum": ["modular"] },
                "createReadme": { "type": "boolean" },
                "emitRuntimeArtifacts": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "enabled", "steps"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["skill", "inputs"],
              "additionalProperties": false,
              "properties": {
                "skill": { "type": "string", "minLength": 1 },
                "inputs": {
                  "type": "object",
                  "additionalProperties": true
                },
                "outputs": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
